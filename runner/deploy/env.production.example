# FlowFit Runner production environment template
# Copy this file to ../.env and fill values on the target machine.
# Never commit or package the filled .env file.

NODE_ENV=production
PORT=3001
STUDIO_ORIGIN=https://your-studio.example.com

# Security
RUNNER_API_KEYS=ff_replace_with_generated_key
SESSION_ENCRYPTION_KEY_BASE64=replace_with_32_random_bytes_base64
SESSION_ENCRYPTION_KEY_ID=default
DEVICE_COMMAND_SECRET=replace_with_random_secret
DEVICE_TOKEN_PEPPER=replace_with_random_pepper
COMPANY_TOKEN_PEPPER=replace_with_random_pepper

# Database
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Company defaults
DEFAULT_COMPANY_ID=company_production
DEFAULT_COMPANY_NAME=FlowFit Production Company

# AI provider
FLOWFIT_AI_PROVIDER=gemini
FLOWFIT_AI_MODEL=gemini-2.0-flash
TASK_UNDERSTANDING_PROVIDER=gemini
TASK_UNDERSTANDING_MODEL=gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Intake
AUTO_UNDERSTAND_INTAKES=true
AUTO_MATCH_TASK_CONTEXT=true
EMAIL_HOST=
EMAIL_PORT=993
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_SOURCE_NAME=gmail_main
EMAIL_COMPANY_ID=company_production
EMAIL_POLL_INTERVAL_MS=60000
EMAIL_MAX_PER_POLL=10
EMAIL_WEBHOOK_SECRET=
SMS_PROVIDER=generic
SMS_WEBHOOK_SECRET=
MESSENGER_WEBHOOK_SECRET=
SITE_POLL_TARGETS_JSON=
FLOWFIT_ATTACHMENT_DIR=

# Workers
SLA_SCANNER_ENABLED=true
SLA_SCANNER_INTERVAL_MS=60000
CONNECTOR_RETRY_WORKER_ENABLED=true
CONNECTOR_RETRY_INTERVAL_MS=30000
CONNECTOR_RETRY_MAX_ATTEMPTS=3

# Gate limits
AUTONOMY_GATE_KILL_SWITCH=false
AUTONOMY_GATE_DAILY_LIMIT=100
APPROVAL_REQUEST_TTL_MINUTES=1440
HIGH_RISK_APPROVAL_REQUEST_TTL_MINUTES=240

# Device operation mode
DEVICE_OFFLINE_AFTER_MS=45000
DEVICE_RECOVERING_AFTER_MS=180000

# Staff channel routing
STAFF_CHANNEL_DEFAULT_ORDER=slack,teams,kakao_work,email,webhook,sms,telegram,manual
STAFF_CHANNEL_DEFAULT_CHANNEL=
STAFF_CHANNEL_COMPANY_ID=company_production
STAFF_CHANNEL_CREDENTIAL_REF=
STAFF_CHANNEL_TARGET=
STAFF_CHANNEL_PRIORITY=10
STAFF_CHANNEL_ENABLED=true
STAFF_CHANNEL_ROUTE_META_JSON=
STAFF_CHANNEL_ROUTES_JSON=
SLACK_BOT_TOKEN=
KAKAOWORK_APP_KEY=
STAFF_WEBHOOK_URL=
GMAIL_ACCESS_TOKEN=
OUTLOOK_ACCESS_TOKEN=
