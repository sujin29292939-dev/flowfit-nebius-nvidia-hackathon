ANTHROPIC_API_KEY=sk-ant-...
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
PORT=3001
STUDIO_ORIGIN=http://localhost:3007
RUNNER_API_KEYS=ff_replace_with_generated_key
SESSION_ENCRYPTION_KEY_BASE64=replace_with_32_random_bytes_base64
SESSION_ENCRYPTION_KEY_ID=default

# 기본 회사
DEFAULT_COMPANY_ID=company_demo
DEFAULT_COMPANY_NAME=FlowFit Demo Company

# 이메일 IMAP 수집
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_SOURCE_NAME=gmail_main
EMAIL_COMPANY_ID=company_demo
EMAIL_POLL_INTERVAL_MS=60000
EMAIL_MAX_PER_POLL=10
EMAIL_WEBHOOK_SECRET=
FLOWFIT_ATTACHMENT_DIR=

# SMS 웹훅 수집
SMS_PROVIDER=generic
SMS_WEBHOOK_SECRET=
SMS_SOURCE_NAME=sms_main

# 사이트 폴링 수집
# 예: [{"companyId":"company_demo","sourceName":"orders_portal","url":"https://example.com/orders","selector":"body","intervalMs":120000}]
SITE_POLL_TARGETS_JSON=

# intake가 저장되면 자동으로 tasks 변환 시도
AUTO_UNDERSTAND_INTAKES=true
TASK_UNDERSTANDING_MODE=auto
GROQ_API_KEY=gsk_...
FLOWFIT_AI_PROVIDER=groq
FLOWFIT_AI_MODEL=openai/gpt-oss-120b
TASK_UNDERSTANDING_PROVIDER=groq
TASK_UNDERSTANDING_MODEL=openai/gpt-oss-120b
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Nebius Token Factory / NVIDIA Nemotron
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# To use Nebius globally:
# FLOWFIT_AI_PROVIDER=nebius
# FLOWFIT_AI_MODEL=nvidia/nemotron-3-super-120b-a12b
# Or only for task understanding:
# TASK_UNDERSTANDING_PROVIDER=nebius
# TASK_UNDERSTANDING_MODEL=nvidia/nemotron-3-super-120b-a12b

# tasks가 생성되면 거래처/품목/재고 맥락 매칭 시도
AUTO_MATCH_TASK_CONTEXT=true

AUTONOMY_EXECUTOR_DRIVER=memory
ANDROID_ACCESSIBILITY_BRIDGE_URL=
ANDROID_ACCESSIBILITY_API_KEY=
ANDROID_ACCESSIBILITY_DEVICE_ID=
OPENCLAW_ACCESSIBILITY_BRIDGE_URL=
OPENCLAW_ACCESSIBILITY_API_KEY=
OPENCLAW_ANDROID_DEVICE_ID=
ACCESSIBILITY_BRIDGE_PATH_PREFIX=
ACCESSIBILITY_BRIDGE_TIMEOUT_MS=10000

STAFF_CHANNEL_DEFAULT_ORDER=slack,teams,kakao_work,email,webhook,sms,telegram,manual
STAFF_CHANNEL_DEFAULT_CHANNEL=
STAFF_CHANNEL_COMPANY_ID=company_demo
STAFF_CHANNEL_CREDENTIAL_REF=
STAFF_CHANNEL_TARGET=
STAFF_CHANNEL_PRIORITY=10
STAFF_CHANNEL_ENABLED=true
STAFF_CHANNEL_ROUTE_META_JSON=
STAFF_CHANNEL_ROUTES_JSON=
SLACK_BOT_TOKEN=
KAKAOWORK_APP_KEY=
STAFF_WEBHOOK_URL=
GMAIL_ACCESS_TOKEN=
OUTLOOK_ACCESS_TOKEN=
