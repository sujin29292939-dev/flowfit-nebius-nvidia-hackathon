# FlowFit UI production environment template
# Copy this file to ../.env.local on the target Mac mini.
# Never package a filled .env.local file.

NODE_ENV=production
PORT=3007

FLOWFIT_RUNNER_URL=http://127.0.0.1:3001
FLOWFIT_RUNNER_API_KEY=replace-with-runner-api-key

FLOWFIT_ENGINE_BASE_URL=http://127.0.0.1:3001
FLOWFIT_BROWSER_ENGINE_BASE_URL=http://127.0.0.1:3001
FLOWFIT_MOBILE_ENGINE_BASE_URL=http://127.0.0.1:3001

NEXT_PUBLIC_FLOWFIT_DISABLE_FIRST_RUN_GATE=0